/* Dashboard Container */
.dashboard-container {
  display: flex;
  min-height: 100vh;
  background-color: #f5f5f5;
  font-family: 'Poppins', sans-serif;
}

.dashboard-main {
  flex: 1;
  margin-left: 0;
  padding: 1rem;
  color: #1f2937;
}

/* Metrics Section */
.metrics-section {
  margin-bottom: 2rem;
}

.section-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.dashboard-main .section-title {
  color: #1f2937;
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

.metrics-grid-4 {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

.metric-card {
  background: white;
  border-radius: 12px;
  padding: 1.5rem;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
  display: flex;
  gap: 1rem;
  transition: transform 0.2s, box-shadow 0.2s;
}

.metric-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
}

.metric-card.clickable,
.chart-card.clickable {
  cursor: pointer;
}

.metric-card.clickable:focus-visible,
.chart-card.clickable:focus-visible {
  outline: 3px solid #2563eb;
  outline-offset: 2px;
}

.metric-card.compact {
  flex-direction: column;
  gap: 0;
}

.metric-icon {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.metric-icon.personnel {
  background: #dbeafe;
  color: #2563eb;
}

.metric-icon.duty {
  background: #fef3c7;
  color: #f59e0b;
}

.metric-icon.attendance {
  background: #dcfce7;
  color: #16a34a;
}

.metric-icon.users {
  background: #e0e7ff;
  color: #6366f1;
}

.metric-icon.active-users {
  background: #dcfce7;
  color: #16a34a;
}

.metric-icon.registrations {
  background: #fce7f3;
  color: #ec4899;
}

.metric-icon.completion {
  background: #ddd6fe;
  color: #7c3aed;
}

.metric-content {
  flex: 1;
}

.metric-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #6b7280;
  margin: 0 0 0.5rem 0;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.metric-value {
  display: flex;
  align-items: baseline;
  gap: 0.25rem;
  margin-bottom: 0.5rem;
}

.main-number {
  font-size: 2rem;
  font-weight: 700;
  color: #111827;
  line-height: 1;
}

.sub-number {
  font-size: 1.2rem;
  color: #9ca3af;
  font-weight: 600;
}

.percentage-sign {
  font-size: 1.2rem;
  color: #9ca3af;
  font-weight: 600;
}

.metric-status {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.metric-status.active {
  background: #dcfce7;
  color: #166534;
}

.duty-split {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.duty-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.duty-count {
  font-size: 1.75rem;
  font-weight: 700;
  line-height: 1;
}

.duty-item.on-duty .duty-count {
  color: #16a34a;
}

.duty-item.off-duty .duty-count {
  color: #9ca3af;
}

/* Responsive: Tablet (640px - 1023px) */
@media (min-width: 640px) {
  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .metrics-grid-4 {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Responsive: Desktop (1024px+) */
@media (min-width: 1024px) {
  .dashboard-main {
    margin-left: 250px;
    padding: 2rem;
  }

  .metrics-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .metrics-grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }
}
